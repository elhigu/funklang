{
  "name": "funklang",
  "version": "1.1.0",
  "description": "Browser reimplementation of AmigaKlang — design Amiga synth instruments and export the real, byte-identical .bin in-browser.",
  "homepage": "https://funklang.mkael.net",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(which chromium) playwright test",
    "e2e:headed": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(which chromium) playwright test --headed --workers=1",
    "e2e:slow": "PLAYWRIGHT_SLOW_MO=400 PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(which chromium) playwright test --headed --workers=1",
    "e2e:ui": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(which chromium) playwright test --ui",
    "e2e:debug": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(which chromium) playwright test --debug",
    "e2e:report": "playwright show-report",
    "gen-verification-patches": "tsx groundtruth/tools/gen-verification-patches.ts",
    "compile:smoke": "nix-shell -p wineWowPackages.stable --run 'GROUNDTRUTH_COMPILE_SMOKE=1 vitest run groundtruth/harness/compile.smoke.test.ts'",
    "export:bin": "tsx groundtruth/harness/export-bin.ts",
    "gate": "npm run typecheck && npm test && npm run e2e",
    "asm:bin": "nix-shell -p mono --run 'npx tsx groundtruth/harness/asm-bin.ts'"
  },
  "keywords": ["amiga", "demoscene", "synthesizer", "m68k", "amigaklang", "chiptune"],
  "author": "Mikael Lepistö (elhigu / funktion)",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.41",
    "jsdom": "^24.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
